# Environment variables — copy to .env and fill in real values
# NEVER commit .env to source control

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/angelswing_api_development

# Secret key used to sign JWT tokens.
# Use a long, random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change_me_in_production_please

# Redis connection URL for the user-auth cache.
# Docker: redis://redis:6379/0  |  Local: redis://localhost:6379/0
# If unset, falls back to Rails in-memory cache (no Redis required for dev/test).
REDIS_URL=redis://localhost:6379/0

# Optional: force HTTPS in production
# FORCE_SSL=true

# Optional: Rails master key (required if using credentials)
# RAILS_MASTER_KEY=
